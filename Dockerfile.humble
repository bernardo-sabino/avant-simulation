FROM osrf/ros:humble-desktop

ARG USERNAME=bernardo
ARG USER_ID=1000
ARG GROUP_ID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    git \
    wget \
    lsb-release \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-opencv \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-gazebo-ros-pkgs \
    libgazebo-dev \
    ros-humble-mavros \
    ros-humble-mavros-extras \
    tmux \
 && rm -rf /var/lib/apt/lists/*

ARG ARDUPILOT_REF=master
RUN git clone --depth 1 --recurse-submodules --branch ${ARDUPILOT_REF} \
     https://github.com/ArduPilot/ardupilot.git /opt/ardupilot \
 && cd /opt/ardupilot \
 && Tools/environment_install/install-prereqs-ubuntu.sh -y

RUN pip3 install --no-cache-dir \
    ultralytics \
    rosbags \
    future \
    lxml \
    pymavlink \
    MAVProxy \
    pyserial \
    pexpect \
    "numpy<2" 

RUN cd /opt/ardupilot \
 && ./waf configure --board sitl \
 && ./waf copter -j4

RUN groupadd -g ${GROUP_ID} ${USERNAME} \
 && useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash ${USERNAME} \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
 && chmod 0440 /etc/sudoers.d/${USERNAME}

RUN rosdep init || true

RUN mkdir -p /home/${USERNAME}/ros2_ws/src \
 && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}

RUN git clone https://github.com/khancyr/ardupilot_gazebo.git /opt/ardupilot_gazebo \
 && perl -0pi -e 's/\n\s*<include>\s*<uri>model:\/\/gimbal_small_2d<\/uri>\s*<pose>.*?<\/include>//s; s/\n\s*<joint name="iris_gimbal_mount".*?<\/joint>//s' /opt/ardupilot_gazebo/models/iris_with_ardupilot/model.sdf \
 && cd /opt/ardupilot_gazebo \
 && mkdir build && cd build \
 && cmake .. \
 && make -j4 \
 && make install

RUN echo "export GAZEBO_MODEL_PATH=/opt/ardupilot_gazebo/models:\${GAZEBO_MODEL_PATH}" >> /etc/bash.bashrc

RUN wget -O /tmp/install_geographiclib_datasets.sh https://raw.githubusercontent.com/mavlink/mavros/ros2/mavros/scripts/install_geographiclib_datasets.sh \
 && chmod +x /tmp/install_geographiclib_datasets.sh \
 && /tmp/install_geographiclib_datasets.sh \
 && rm /tmp/install_geographiclib_datasets.sh

USER ${USERNAME}
ENV HOME=/home/${USERNAME}
WORKDIR /home/${USERNAME}

RUN rosdep update || true
RUN echo "source /opt/ros/humble/setup.bash" >> /home/${USERNAME}/.bashrc

CMD ["/bin/bash"]